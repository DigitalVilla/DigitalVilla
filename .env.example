# ── Client (baked in at build time by Vite) ─────────────────────────────────
# Where the contact form posts — the Lambda Function URL from README → Deployment.
# Leave empty to skip the network round-trip and open the visitor's mail client.
VITE_CONTACT_ENDPOINT=

# ── Deploy (read by scripts/deploy.sh, which sources this file) ─────────────
S3_BUCKET=
# Optional: invalidate after upload
CLOUDFRONT_DISTRIBUTION_ID=
# Optional: AWS_PROFILE=digitalvilla

# ── Lambda (set as *function* environment variables, not here) ─────────────
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=digitalvilla01@gmail.com
# CONTACT_FROM_EMAIL="Digital Villa <hello@digitalvilla.ca>"   # sender on a Resend-verified domain
